<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.rurulalanana</groupId>
  <artifactId>gb28181</artifactId>
  <!--
    全工程唯一的版本号。

    六个子模块的 pom 都【不再写自己的 <version>】，全从里继承；
    模块之间的相互依赖也不写硬编码版本，统一用 ${project.version}
    （见下方 <dependencyManagement>）。

    所以升级版本只改这一行，不用再去六个子 pom 里逐个找 ——
    以前版本号散在 7 处（根 pom + 五个 dependencyManagement + starter 的五个 xxx.module.version 属性），
    每次发版都容易漏改一个，然后 fat jar 里嵌的是旧库。
  -->
  <version>2.0.0</version>
  <packaging>pom</packaging>

  <name>gb28181</name>
  <description>
    GB/T 28181 视频监控平台 —— 单仓库父子工程。

    模块与职责（全部 Java 17）：
      gb28181-sip                信令（SIP / MANSCDP / SDP / 级联 / 集群）
      gb28181-sip-zlm            媒体（内嵌 ZLMediaKit、RTP 收流、回放）
      device-access              设备接入契约（厂商无关 SPI，零 Spring）
      sdk-dahua                  大华 NetSDK 实现
      sdk-hikvision              海康 ISUP(EHome) 实现
      gb28181-platform-starter   平台应用（Spring Boot 3 + Vue 前端）

    依赖方向（单向，不可反向）：
      starter → sip-zlm → sip
      starter → sip
      starter → sdk-dahua     → device-access
      starter → sdk-hikvision → device-access

    统一 Java 17 与统一版本号：
      早期 sip / sip-zlm 是 Java 8，为了让只跑 JDK 8 的对接方也能用这两个协议库。
      合并成单仓库后整个平台只交付一个 Spring Boot jar，两个协议库不再独立发布，
      因此统一到 17。这是破坏性变更：字节码版本从 52 变成 61，JDK 8/11 无法加载。

      版本号同步统一到 2.0.0：六个模块共用一个版本，由根 &lt;version&gt; 单点决定。
      之所以是 2.x 而不是 1.0.x —— Maven Central 上 sip 已有 1.0.0~1.0.6、
      sip-zlm 已有 1.0.0~1.0.4，且那些都是 Java 8 字节码，
      用同一坐标发性能不同的 jar 会让下游拿到「版本号一样、行为不一样」的东西。

    关于 spring-boot-starter-parent：
      Java 只允许一个 parent，所以 gb28181-platform-starter 不能再继承
      spring-boot-starter-parent，改为 import spring-boot-dependencies BOM，
      等价拿到全部依赖版本管理；插件侧只有 spring-boot-maven-plugin 需要显式配置。

    构建：
      mvn clean install -DskipTests
      mvn clean install -DskipTests -pl gb28181-sip,gb28181-sip-zlm,device-access,gb28181-platform-starter
  </description>
  <url>https://github.com/rurulalanana/gb28181</url>

  <modules>
    <module>gb28181-sip</module>
    <module>gb28181-sip-zlm</module>
    <module>device-access</module>
    <module>sdk-dahua</module>
    <module>sdk-hikvision</module>
    <module>gb28181-platform-starter</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      全工程统一 Java 17。

      【历史】早期 sip / sip-zlm 是 Java 8（为了让只跑 JDK 8 的对接方也能用这两个协议库）。
      合并成单仓库父子工程后统一到 17：整个平台只交付一个 Spring Boot jar，
      sip / sip-zlm 不再作为独立可被第三方直接依赖的产物单独发布。

      【破坏性，改动前请知情】Maven Central 上已发布的 sip 1.0.0~1.0.6 /
      sip-zlm 1.0.0~1.0.4 都是 Java 8 字节码（major=52）。
      统一到 17 后产出的 class 是 major=61，JDK 8 / 11 的用户无法加载。
      因此本轮把全工程版本统一提到 2.0.0（见根 <version>），不复用 1.0.x 坐标。

      各模块都用 maven.compiler.release 声明，不写 source/target：
      release 会同时校验「语法级别」与「平台 API」，能拦住
      「本地 JDK 21 能过、目标 JDK 17 上跑不起来」这类问题。
    -->
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <!-- ========== 第三方依赖版本（全模块统一） ========== -->
    <slf4j.version>1.7.36</slf4j.version>
    <junit.version>5.10.2</junit.version>
    <junit4.version>4.13.2</junit4.version>
    <jackson.version>2.15.4</jackson.version>
    <commons.lang3.version>3.12.0</commons.lang3.version>

    <!-- ========== 插件版本 ========== -->
    <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
    <maven.jar.plugin.version>3.3.0</maven.jar.plugin.version>
    <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    <maven.clean.plugin.version>3.2.0</maven.clean.plugin.version>
    <maven.install.plugin.version>3.1.4</maven.install.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- ========== 本项目内部模块（升级只改这里） ========== -->
      <dependency>
        <groupId>io.github.rurulalanana</groupId>
        <artifactId>gb28181-sip</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.rurulalanana</groupId>
        <artifactId>gb28181-sip-zlm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.rurulalanana</groupId>
        <artifactId>device-access</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.rurulalanana</groupId>
        <artifactId>sdk-dahua</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.rurulalanana</groupId>
        <artifactId>sdk-hikvision</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- ========== 通用第三方 ========== -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>${junit4.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          只统一插件【版本】，各模块自己决定 configuration。

          注意 maven-compiler-plugin：sip / sip-zlm 的 pom 里显式钉了 3.8.1，
          会覆盖这里的 3.11.0。两者的 release 都是 ${java.version}，编译行为一致，
          保留旧版本是因为这两个模块的 javadoc/lombok 配置与之配套，单独升插件有回归风险。
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven.clean.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven.jar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven.install.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
